{
  "name": "QUIC Direct Sockets Demo",
  "short_name": "QUIC Direct",
  "description": "QUIC protocol implementation using Direct Sockets API",
  "version": "1.0.0",
  "manifest_version": 3,
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "permissions": [
    "direct-sockets"
  ],
  "isolated_app": {
    "signed_web_bundle_id": "to-be-generated"
  }
}